# Variables de entorno del servicio. Copiar a .env y completar (sin committear valores reales).
# .NET mapea "__" a ":" en la configuracion (ConnectionStrings__Accounts -> ConnectionStrings:Accounts).
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# PostgreSQL (EF Core + Npgsql)
ConnectionStrings__Accounts=Host=localhost;Port=5432;Database=accounts_db;Username=;Password=

# Redis (cache distribuida)
ConnectionStrings__Redis=localhost:6379
Cache__Ttl=00:05:00

# SQS (eventos de dominio). ServiceUrl solo para LocalStack.
Messaging__Sqs__QueueUrl=
Messaging__Sqs__ServiceUrl=http://localhost:4566
Messaging__Sqs__BufferCapacity=1000

# Hub de eventos en proceso (Server-Sent Events)
EventStream__SubscriberBufferSize=256
AWS_REGION=us-east-1

# Proveedor externo de credit score
CreditScore__BaseUrl=http://localhost:8081
CreditScore__Timeout=00:00:05

# OpenTelemetry (OTLP). Vacio = no exporta.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=pragma-accounts
