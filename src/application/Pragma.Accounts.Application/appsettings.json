{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Accounts": "",
    "Redis": ""
  },
  "Persistence": {
    "AutoCreateSchema": false
  },
  "Cache": {
    "Ttl": "00:05:00"
  },
  "Messaging": {
    "Sqs": {
      "QueueUrl": "",
      "ServiceUrl": "",
      "BufferCapacity": 1000
    }
  },
  "CreditScore": {
    "BaseUrl": "http://localhost:8081",
    "Timeout": "00:00:05"
  },
  "EventStream": {
    "SubscriberBufferSize": 256
  }
}
