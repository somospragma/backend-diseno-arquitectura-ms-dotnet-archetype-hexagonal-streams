<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: los nombres de test usan guion bajo (Metodo_Escenario_Resultado). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>

    <!-- Gate de cobertura (coverlet.MTP): ver testconfig.json. Se activa con la opcion coverlet de dotnet test (ver README). -->
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="TngTech.ArchUnitNET" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <None Update="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\application\Pragma.Accounts.Application\Pragma.Accounts.Application.csproj" />
    <!-- Referencias directas al dominio: Stryker muta solo proyectos referenciados directamente. -->
    <ProjectReference Include="..\..\src\domain\Pragma.Accounts.Domain.Model\Pragma.Accounts.Domain.Model.csproj" />
    <ProjectReference Include="..\..\src\domain\Pragma.Accounts.Domain.UseCases\Pragma.Accounts.Domain.UseCases.csproj" />
  </ItemGroup>
</Project>
